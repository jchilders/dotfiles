#!/usr/bin/env zsh

# clean up history without wholly deleting it: get rid of entries that are
# erroneous/wrong

emulate -L zsh
setopt extendedglob

if (( $# != 1 )); then
  print -u2 "usage: history_prune <extended-regex>"
  return 1
fi

local re=$1
local histfile=${HISTFILE:-$HOME/.zsh_history}
local tmp=${histfile}.tmp

# Flush current session to disk.
fc -W

# Rewrite the history file.
local before=$(wc -l < "$histfile")
perl -ne "print unless /$re/" "$histfile" > "$tmp" &&
  mv "$tmp" "$histfile" || return 1
local after=$(wc -l < "$histfile")
print "removed $(( before - after )) entries"

# Clear the in-memory history.
fc -p

# Reload the filtered history.
fc -R "$histfile"
